## example input file (for ver. 2.1.0)
## generated by glafic -d

## setting primary parameters
omega     0.300000
lambda    0.700000
weos      -1.000000
hubble    0.700000
prefix    /Users/ainsleylewis/Documents/Astronomy/TestLens/out/extend
xmin	  -50.000000
ymin	  -50.000000
xmax	  50.000000
ymax	  50.000000
pix_ext   0.200000
pix_poi   3.000000
maxlev	  5

## some examples of secondaextry parameters
#srcfile        /Users/ainsleylewis/Documents/Astronomy/TestLens/input/srcfile.dat
#ran_seed       -1234
flag_extnorm   1
obs_gain       3.0
obs_ncomb      3
obs_readnoise  10.0
#psfconv_size   4.0
#seeing_sub     1
flag_srcsbin   1

## define lenses and sources
startup 2 1 0
lens pow  0.3 0.4 0.0 0.0 0.5 45.0 8.0 2.6
lens mpole 0.3 0.4 0.0 0.0 0.05 0.0 4 2.6
extend sersic 0.5 5e10 0.0 0.0 0.6 45.0 8.0 4.0
psf 0.8 0.02 -45.0 5.0 0.8 0.0 0.0 5.0 1.0
end_startup

## execute commands
start_command

writeimage 3.0e3 -1.0
writeimage_ori 3.0e3 -1.0
writepsf

quit
